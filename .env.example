# URL of the backend API on your cPanel server (no trailing slash), e.g. https://api.yourdomain.com
# Leave empty in local development (the Vite dev server proxies /api to VITE_PROXY_TARGET).
VITE_API_URL=

# Public URL of the customer website - store QR codes point here, e.g. https://your-website.vercel.app
VITE_WEBSITE_URL=https://localhost:5173

# Dev only: where the Vite proxy forwards /api and /socket.io
VITE_PROXY_TARGET=http://localhost:4000
