# Copy to .env for local development (never commit .env).
# On Vercel, set the same variables in Project -> Settings -> Environment Variables.

# Backend on Render, e.g. https://epson-connect-api.onrender.com (no trailing slash).
# Leave empty locally: the dev server proxies /api to VITE_PROXY_TARGET.
VITE_API_URL=

# Customer website (its Vercel URL in production). Store QR codes point here.
VITE_WEBSITE_URL=https://localhost:5173

# Local development only: where the dev server forwards /api and /socket.io
VITE_PROXY_TARGET=http://localhost:4000
